# Allowlisting gitignore template for GO projects prevents us
# from adding various unwanted local files, such as generated
# files, developer configurations or IDE-specific files etc.
#
# Recommended: Go.AllowList.gitignore

# Ignore everything
*

# But not these files...
!/.gitattributes
!/.gitignore
!/.github/workflows/*

!*.go
!*.s
!go.sum
!go.mod

!README.md
!LICENSE.md

!doc/*

# !Makefile

# ...even if they are in subdirectories
!*/
!/cmd/
!/cmd/display-test-framebuffer/
!/cmd/display-test-framebuffer/assets/
!/cmd/display-test-framebuffer/assets/*
!/internal/
!/internal/buffer/
!/support/gu256x64d7000_proxy/gu256x64d7000_proxy.ino
!/support/gu256x64d7000_proxy/xmodem_crc.h
!/support/gu256x64d7000_proxy/benchmark/Arduino.h
!/support/gu256x64d7000_proxy/benchmark/bench.cpp
!/support/gu256x64d7000_proxy/benchmark/run.py
!/support/arduino/GU256X64D7000/library.properties
!/support/arduino/GU256X64D7000/src/GU256X64D7000.h
!/support/arduino/GU256X64D7000/examples/HelloVFD/HelloVFD.ino
!/support/arduino/GU256X64D7000/examples/BitmapVFD/BitmapVFD.ino
